{
  "name": "hazen-desktop",
  "productName": "Hazen",
  "version": "1.0.0",
  "description": "Hazen - pro camera, album and editor with on-device AI",
  "author": { "name": "Aswanth R", "email": "aswanthr82@gmail.com" },
  "homepage": "https://nodex-ar.github.io/hazen/",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.hazen.camera",
    "productName": "Hazen",
    "artifactName": "Hazen-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "demo.html", "build/icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Hazen uses the camera to take photos and videos.",
        "NSMicrophoneUsageDescription": "Hazen uses the microphone to record sound with your videos."
      }
    },
    "linux": { "target": ["AppImage", "deb"], "category": "Graphics", "icon": "build/icon.png", "maintainer": "Aswanth R <aswanthr82@gmail.com>" }
  }
}
