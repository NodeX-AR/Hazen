{
  "name": "hazen-desktop",
  "productName": "Hazen",
  "version": "1.0.0",
  "description": "Hazen - pro camera, album and editor with on-device AI",
  "author": {
    "name": "Aswanth R",
    "email": "aswanthr82@gmail.com"
  },
  "homepage": "https://nodex-ar.github.io/hazen/",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.hazen.camera",
    "productName": "Hazen",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "demo.html",
      "models/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Hazen-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hazen",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Hazen-Portable-x64.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Hazen-mac-${arch}.${ext}",
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Hazen uses the camera to take photos and videos.",
        "NSMicrophoneUsageDescription": "Hazen uses the microphone to record sound with your videos."
      }
    },
    "dmg": {
      "artifactName": "Hazen-mac-${arch}.dmg",
      "title": "Install Hazen",
      "background": "build/dmg-background.png",
      "iconSize": 112,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "Aswanth R <aswanthr82@gmail.com>"
    },
    "appImage": {
      "artifactName": "Hazen-linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "Hazen-linux-x64.deb"
    }
  }
}